{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notice-sloth",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" }
}
